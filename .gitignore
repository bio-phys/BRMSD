# Package metadata (generated by pip install -e .)
*.egg-info/

# Build outputs (generated by python -m build)
dist/
build/

# Python cache
__pycache__/
*.py[cod]

# MDAnalysis trajectory index files
*.xtc_offsets.npz
*.xtc_offsets.lock
.*.xtc_offsets.*

# Logs and output files (generated by meRMSD runs)
*.log

# OS
.DS_Store

# Benchmark scripts tracked; large data files excluded below
benchmark/**/*.xtc
benchmark/**/*.gro
benchmark/**/*.trr
benchmark/**/*.dcd
benchmark/**/*.npy
benchmark/**/*.pdb
benchmark/**/graphify-out/
benchmark/**/logs/
benchmark/**/figs/
benchmark/**/__pycache__/

# Manuscript source files
meRMSD_manuscript.tex
meRMSD_manuscript.bib
meRMSD.tex

# Test coverage and HTML reports
.coverage
report.html
htmlcov/
.pytest_cache/

# Large binary simulation data — keep out of the repo
TIM/
*.mp4
*.avi
*.mov

# GROMACS binary outputs
*.trr
*.edr
*.tpr
*.cpt

# Local-only changelog (not for release)
CHANGELOG.md

# VMD render intermediates (PNG/PDF are the deliverables)
*.ppm

# Jupyter checkpoints
.ipynb_checkpoints/

# Not for GitHub: benchmark -> Zenodo, manuscript -> journal (kept locally)
benchmark/
manuscript/
